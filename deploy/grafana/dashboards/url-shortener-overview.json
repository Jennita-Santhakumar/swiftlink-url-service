{
  "title": "URL Shortener Overview",
  "uid": "url-shortener-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Redirects by Result (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(urlshortener_redirects_total[1m])) by (result)", "legendFormat": "{{result}}" }
      ]
    },
    {
      "id": 2,
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(urlshortener_redirects_total{result=\"hit\"}[5m])) / sum(rate(urlshortener_redirects_total{result=~\"hit|miss\"}[5m]))",
          "legendFormat": "cache hit rate"
        }
      ]
    },
    {
      "id": 3,
      "title": "URLs Created (total)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "urlshortener_urls_created_total", "legendFormat": "created" }
      ]
    },
    {
      "id": 4,
      "title": "Redirect Latency (P50 / P95 / P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(urlshortener_redirect_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(urlshortener_redirect_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(urlshortener_redirect_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 5,
      "title": "Dropped Click Events (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "rate(urlshortener_dropped_click_events_total[1m])", "legendFormat": "dropped/s" }
      ]
    },
    {
      "id": 6,
      "title": "Rate Limited Requests (total)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "targets": [
        { "expr": "urlshortener_rate_limited_total", "legendFormat": "rate limited" }
      ]
    }
  ]
}
